# ==============================================================================
# DRAGON TIGER P2P PLATFORM - ENVIRONMENT CONFIGURATION
# ==============================================================================

# Node Environment
NODE_ENV=development
PORT=4000
HOST=0.0.0.0

# Database Configuration (PostgreSQL)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/dragontiger?schema=public&connection_limit=50&pool_timeout=30

# Redis Configuration (Cache, Pub/Sub, Matching Engine, Rate Limit)
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0

# Authentication & Security
JWT_ACCESS_SECRET=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
JWT_REFRESH_SECRET=fedcba9876543210fedcba9876543210fedcba9876543210fedcba9876543210
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Provably Fair & Cryptographic Keys
SEED_ENCRYPTION_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
SENSITIVE_DATA_ENCRYPTION_KEY=abcdef0123456789abcdef0123456789abcdef0123456789abcdef0123456789

# Game Engine Parameters
COMMISSION_RATE=0.05
REFERRAL_COMMISSION_RATE=0.01
DEFAULT_CLIENT_SEED=dragon_tiger_provably_fair_master_seed_2026

# Merchant & Aggregator Integration
MERCHANT_SIGNATURE_EXPIRY_MS=300000
AGGREGATOR_DEFAULT_CURRENCY=INR

# Worker & Queue
BULLMQ_CONCURRENCY=10
WEBHOOK_MAX_RETRIES=3

# Frontend URL & CORS
CORS_ORIGIN=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:4000
NEXT_PUBLIC_WS_URL=http://localhost:4000

# Logging & Monitoring
LOG_LEVEL=info
PROMETHEUS_METRICS_ENABLED=true
